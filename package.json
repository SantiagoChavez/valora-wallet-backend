{
  "name": "valora-wallet-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST para Valora Wallet, billetera digital multi-moneda para freelancers y trabajadores remotos en LATAM.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
