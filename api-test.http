@baseUrl = http://localhost:3000
@token = {{login.response.body.data.token}}

### 0. Health Check
GET {{baseUrl}}/health

### 1. Registrar usuario (Auth)
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "santiago.demo@valora.com",
  "password": "Password123!",
  "firstName": "Santiago",
  "lastName": "Chavez",
  "dateOfBirth": "15/05/1995",
  "phone": "+5493511234567",
  "country": "AR",
  "du": "12345678"
}

### 2. Iniciar Sesión (Auth)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "santiago.demo@valora.com",
  "password": "Password123!"
}

### 3. Obtener Perfil (Auth)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 4. Configurar Alias (Wallet)
PUT {{baseUrl}}/wallet/alias
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "alias": "santiago.valora"
}

### 5. Realizar Depósito (Transactions)
POST {{baseUrl}}/transactions/deposit
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currency": "USD",
  "amount": 500
}

### 6. Realizar Intercambio (Transactions)
POST {{baseUrl}}/transactions/exchange
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "fromCurrency": "USD",
  "toCurrency": "ARS",
  "amount": 100
}

### 7. Ver Transacciones (Transactions)
GET {{baseUrl}}/transactions?limit=10&page=1
Authorization: Bearer {{token}}

### 8. Ver Saldos Actuales (Balances)
GET {{baseUrl}}/balances
Authorization: Bearer {{token}}

### 9. Chatbot - Asistente Financiero
POST {{baseUrl}}/chatbot/message
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "message": "¿Me alcanza el saldo para comprar un café de 5 euros?"
}